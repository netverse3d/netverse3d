{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netverse3d.github.io/contracts/world/shop-look.v1.schema.json",
  "title": "Shop look",
  "description": "Công thức bản sắc của một tiệm: bộ màu, biến thể theo ô đồ, bố cục, biển hiệu, kiểu đèn. Tên hàng màu và tên ô đồ lấy từ assets.config.json của game-assets.",
  "x-status": "draft",
  "type": "object",
  "required": ["id", "name", "palette", "variants", "layout", "sign", "lighting"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "palette": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/stops"
      }
    },
    "emissive": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/stops"
      }
    },
    "keyboard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "colorway": {
          "type": "string",
          "pattern": "^[a-z]+$"
        },
        "led": {
          "type": "string",
          "enum": ["rainbow", "single", "white", "off"]
        }
      }
    },
    "variants": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z]$"
      }
    },
    "layout": {
      "$ref": "#/$defs/layout"
    },
    "sign": {
      "type": "object",
      "required": ["text"],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24
        },
        "style": {
          "enum": ["neon", "led", "painted"]
        }
      }
    },
    "lighting": {
      "enum": ["neon", "dim", "warm", "daylight"]
    }
  },
  "$defs": {
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-f]{6}$"
    },
    "stops": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/color"
      }
    },
    "cell": {
      "description": "Ô sàn [x, z]: x đếm từ tường west (0) sang east, z đếm từ tường north (0) xuống south.",
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "wall": {
      "description": "north là cạnh z = 0, south là cạnh z = sâu − 1, west là cạnh x = 0, east là cạnh x = rộng − 1.",
      "enum": ["north", "south", "east", "west"]
    },
    "opening": {
      "description": "Một ô mở trên tường; at là chỉ số ô dọc theo tường đó, tính như x cho north và south, như z cho east và west.",
      "type": "object",
      "required": ["wall", "at"],
      "additionalProperties": false,
      "properties": {
        "wall": {
          "$ref": "#/$defs/wall"
        },
        "at": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "layout": {
      "type": "object",
      "required": ["cells", "stations", "door"],
      "additionalProperties": false,
      "properties": {
        "cells": {
          "description": "Kích thước phòng [rộng, sâu] tính bằng ô 2 m.",
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16
          }
        },
        "stations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["cell", "facing"],
            "additionalProperties": false,
            "properties": {
              "cell": {
                "$ref": "#/$defs/cell"
              },
              "facing": {
                "description": "Hướng người ngồi nhìn; màn hình nằm ở phía đó của ô.",
                "$ref": "#/$defs/wall"
              }
            }
          }
        },
        "door": {
          "description": "Lối vào duy nhất; ô sàn ngay trong cửa phải để trống.",
          "$ref": "#/$defs/opening"
        },
        "windows": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/opening"
          }
        }
      }
    }
  }
}
