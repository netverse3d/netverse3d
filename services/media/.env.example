NODE_ENV=development
SERVICE_NAME=media
SERVICE_VERSION=0.1.0
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/media_service
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=0
BODY_LIMIT=1mb
REQUEST_TIMEOUT_MS=30000
SWAGGER_ENABLED=true
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120
AUTH_JWKS_URL=http://localhost:4000/.well-known/jwks.json
AUTH_ISSUER=http://localhost:4000
AUTH_AUDIENCE=media-service
AUTH_ROLES_CLAIM=roles
AUTH_TENANT_CLAIM=tenant_id
S3_ENDPOINT=localhost
S3_PORT=8333
S3_USE_SSL=false
S3_REGION=us-east-1
S3_ACCESS_KEY=dev-access-key
S3_SECRET_KEY=dev-secret-key
S3_BUCKET_PRIVATE=media-private
S3_BUCKET_INTERNAL=media-internal
S3_BUCKET_PUBLIC=media-public
S3_BUCKET_TEMP=media-temp
S3_AUTO_CREATE_BUCKETS=true
S3_UPLOAD_URL_TTL_SECONDS=900
S3_DOWNLOAD_URL_TTL_SECONDS=300
MEDIA_USER_CONTENT_MAX_BYTES=26214400
MEDIA_SYSTEM_ASSET_MAX_BYTES=524288000
MEDIA_USER_CONTENT_REQUIRES_REVIEW=false
JOBS_ENABLED=true
MEDIA_PENDING_EXPIRY_SECONDS=86400
MEDIA_HARD_DELETE_GRACE_SECONDS=86400
MEDIA_REAPER_INTERVAL_SECONDS=300
OUTBOX_RELAY_INTERVAL_MS=5000
OUTBOX_MAX_ATTEMPTS=12
