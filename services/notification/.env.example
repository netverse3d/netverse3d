NODE_ENV=development
SERVICE_NAME=notification
SERVICE_VERSION=0.1.0
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/notification
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=0
BODY_LIMIT=1mb
REQUEST_TIMEOUT_MS=30000
SWAGGER_ENABLED=true
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120
AUTH_JWKS_URL=http://localhost:4000/.well-known/jwks.json
AUTH_ISSUER=http://localhost:4000
AUTH_AUDIENCE=notification
AUTH_ROLES_CLAIM=roles
AUTH_TENANT_CLAIM=tenant_id
DEFAULT_LOCALE=en
EMAIL_PROVIDER=log
PUSH_PROVIDER=log
PROVIDER_TIMEOUT_MS=10000
EVENT_TRANSPORT=none
KAFKA_BROKERS=
JOBS_ENABLED=true
DELIVERY_POLL_INTERVAL_MS=2000
DELIVERY_BATCH_SIZE=50
DELIVERY_CONCURRENCY=10
DELIVERY_MAX_ATTEMPTS=6
DELIVERY_RETRY_BASE_MS=30000
DELIVERY_RETRY_MAX_MS=3600000
DELIVERY_LEASE_MS=300000
OUTBOX_RELAY_INTERVAL_MS=5000
OUTBOX_MAX_ATTEMPTS=12
