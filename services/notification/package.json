{
  "name": "@netverse/notification",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "files": [
    "dist",
    "generated",
    "prisma",
    "prisma.config.ts"
  ],
  "scripts": {
    "postinstall": "prisma generate && pnpm grpc:generate",
    "build": "pnpm grpc:generate && nest build -p tsconfig.build.json",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "pnpm grpc:generate && tsc --noEmit --incremental false",
    "test": "jest",
    "test:e2e": "prisma migrate deploy && jest --config test/jest-e2e.json --runInBand",
    "openapi:export": "ts-node scripts/export-openapi.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "grpc:generate": "proto-loader-gen-types --longs=String --enums=String --defaults --oneofs --grpcLib=@grpc/grpc-js --outDir=src/generated/grpc ../../packages/contracts/grpc/v1/notification.proto"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/throttler": "^6.7.1",
    "@netverse/nest-kit": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@prisma/client-runtime-utils": "7.10.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "dotenv": "^17.2.3",
    "handlebars": "^4.7.10",
    "helmet": "^8.3.0",
    "jose": "^5.10.0",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "10.5.0",
    "pg": "^8.17.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prisma": "7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@grpc/grpc-js": "1.14.7",
    "@grpc/proto-loader": "0.8.1",
    "@nestjs/cli": "^11.0.17",
    "@nestjs/schematics": "^11.0.10",
    "@nestjs/testing": "^11.2.8",
    "@netverse/contracts": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.19.7",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jest": "^30.4.2",
    "js-yaml": "^4.1.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": "test/unit/.*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
