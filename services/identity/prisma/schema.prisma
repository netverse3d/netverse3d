generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AuditOutcome {
  SUCCESS
  FAILURE
}

model AuditLog {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  occurredAt   DateTime     @default(now()) @map("occurred_at") @db.Timestamptz
  requestId    String?      @map("request_id") @db.VarChar(128)
  tenantId     String?      @map("tenant_id") @db.VarChar(128)
  actorSubject String?      @map("actor_subject") @db.VarChar(255)
  actorRoles   String[]     @default([]) @map("actor_roles")
  ip           String?      @db.VarChar(64)
  userAgent    String?      @map("user_agent") @db.VarChar(512)
  action       String       @db.VarChar(128)
  resourceType String       @map("resource_type") @db.VarChar(64)
  resourceId   String?      @map("resource_id") @db.VarChar(255)
  outcome      AuditOutcome
  errorCode    String?      @map("error_code") @db.VarChar(128)
  metadata     Json         @default("{}")

  @@index([tenantId, occurredAt])
  @@index([resourceType, resourceId])
  @@index([actorSubject, occurredAt])
  @@map("audit_logs")
}

enum PrincipalStatus {
  ACTIVE
  SUSPENDED
}

enum SocialProvider {
  GOOGLE
  FACEBOOK
  APPLE
  ZALO
  GITHUB
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum MembershipStatus {
  ACTIVE
  REVOKED
}

enum OtpPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum SigningKeyStatus {
  ACTIVE
  RETIRING
  REVOKED
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  DEAD
}

model Principal {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String?         @unique @db.VarChar(320)
  emailVerifiedAt DateTime?       @map("email_verified_at") @db.Timestamptz
  passwordHash    String?         @map("password_hash") @db.VarChar(255)
  displayName     String?         @map("display_name") @db.VarChar(120)
  avatarUrl       String?         @map("avatar_url") @db.VarChar(1024)
  status          PrincipalStatus @default(ACTIVE)
  isPlatformAdmin Boolean         @default(false) @map("is_platform_admin")
  tokenVersion    Int             @default(0) @map("token_version")
  failedLogins    Int             @default(0) @map("failed_logins")
  lockedUntil     DateTime?       @map("locked_until") @db.Timestamptz
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  externalIdentities ExternalIdentity[]
  memberships        Membership[]
  sessions           Session[]
  otpCodes           OtpCode[]

  @@map("principals")
}

model ExternalIdentity {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  principalId     String         @map("principal_id") @db.Uuid
  provider        SocialProvider
  providerSubject String         @map("provider_subject") @db.VarChar(255)
  email           String?        @db.VarChar(320)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz

  principal Principal @relation(fields: [principalId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@unique([principalId, provider])
  @@map("external_identities")
}

model Tenant {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug      String       @unique @db.VarChar(64)
  name      String       @db.VarChar(120)
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  roles       Role[]
  memberships Membership[]

  @@map("tenants")
}

enum ServiceClientStatus {
  ACTIVE
  REVOKED
}

model ServiceClient {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String              @unique @db.VarChar(64)
  secretHash      String              @map("secret_hash") @db.VarChar(64)
  audiences       String[]            @default([])
  permissions     String[]            @default([])
  status          ServiceClientStatus @default(ACTIVE)
  secretRotatedAt DateTime            @default(now()) @map("secret_rotated_at") @db.Timestamptz
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  @@map("service_clients")
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String   @db.VarChar(64)
  permissions String[] @default([])
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships MembershipRole[]

  @@unique([tenantId, name])
  @@map("roles")
}

model Membership {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  principalId String           @map("principal_id") @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  status      MembershipStatus @default(ACTIVE)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  principal Principal        @relation(fields: [principalId], references: [id], onDelete: Cascade)
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roles     MembershipRole[]

  @@unique([principalId, tenantId])
  @@index([tenantId])
  @@map("memberships")
}

model MembershipRole {
  membershipId String @map("membership_id") @db.Uuid
  roleId       String @map("role_id") @db.Uuid

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
  @@map("membership_roles")
}

model Session {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  principalId String    @map("principal_id") @db.Uuid
  tenantId    String?   @map("tenant_id") @db.Uuid
  ip          String?   @db.VarChar(64)
  userAgent   String?   @map("user_agent") @db.VarChar(512)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastUsedAt  DateTime  @default(now()) @map("last_used_at") @db.Timestamptz
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz

  principal     Principal      @relation(fields: [principalId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([principalId])
  @@index([expiresAt])
  @@map("sessions")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("refresh_tokens")
}

model OtpCode {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  principalId String     @map("principal_id") @db.Uuid
  purpose     OtpPurpose
  codeHash    String     @map("code_hash") @db.VarChar(64)
  attempts    Int        @default(0)
  expiresAt   DateTime   @map("expires_at") @db.Timestamptz
  consumedAt  DateTime?  @map("consumed_at") @db.Timestamptz
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz

  principal Principal @relation(fields: [principalId], references: [id], onDelete: Cascade)

  @@index([principalId, purpose, createdAt])
  @@map("otp_codes")
}

model SigningKey {
  kid           String           @id @db.VarChar(64)
  status        SigningKeyStatus
  publicJwk     Json             @map("public_jwk")
  privateKeyEnc String           @map("private_key_enc")
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz
  retiredAt     DateTime?        @map("retired_at") @db.Timestamptz

  @@map("signing_keys")
}

model OutboxEvent {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type          String       @db.VarChar(128)
  aggregateId   String       @map("aggregate_id") @db.Uuid
  tenantId      String?      @map("tenant_id") @db.VarChar(128)
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  nextAttemptAt DateTime     @default(now()) @map("next_attempt_at") @db.Timestamptz
  lastError     String?      @map("last_error")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz
  publishedAt   DateTime?    @map("published_at") @db.Timestamptz

  @@index([status, nextAttemptAt])
  @@map("outbox_events")
}
