NODE_ENV=development
SERVICE_NAME=identity
SERVICE_VERSION=0.1.0
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/identity_service
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=0
BODY_LIMIT=1mb
REQUEST_TIMEOUT_MS=30000
SWAGGER_ENABLED=true
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=20
AUTH_JWKS_URL=http://localhost:3000/.well-known/jwks.json
AUTH_ISSUER=http://localhost:3000
AUTH_AUDIENCE=identity
AUTH_ROLES_CLAIM=roles
AUTH_TENANT_CLAIM=tenant_id
TOKEN_AUDIENCES=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_REUSE_GRACE_SECONDS=10
KEY_ENCRYPTION_SECRET=changeme
KEY_RETIRE_GRACE_HOURS=24
PASSWORD_BCRYPT_COST=12
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_HASH_SECRET=changeme
OTP_DELIVERY=log
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
JOBS_ENABLED=true
CLEANUP_INTERVAL_SECONDS=3600
OUTBOX_RELAY_INTERVAL_MS=5000
OUTBOX_MAX_ATTEMPTS=12
