{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2023",
    "lib": ["ES2023"],
    "outDir": "dist",
    "rootDir": ".",
    "strictPropertyInitialization": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "incremental": true,
    "types": ["node", "jest"],
    "moduleResolution": "node10",
    "paths": {
      "@app/*": ["./src/*"],
      "@test/*": ["./test/*"]
    }
  },
  "include": ["src", "test/unit", "scripts", "prisma.config.ts"]
}
