{
  "name": "netverse3d",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=22.14 <23",
    "pnpm": ">=11"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "lint": "eslint .",
    "format": "node scripts/format.mjs --write",
    "format:check": "node scripts/format.mjs --check",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "verify": "pnpm verify:repo && turbo run lint test build",
    "verify:repo": "pnpm lint && pnpm format:check && pnpm test:scripts && pnpm trace:check && pnpm catalog:check && pnpm boundaries:check && pnpm flags:check && pnpm docs:check",
    "trace:check": "node scripts/trace/check-registry.mjs",
    "trace:link": "node scripts/drift/link.mjs",
    "catalog:check": "node scripts/catalog/check.mjs",
    "boundaries:check": "node scripts/boundaries/check.mjs",
    "flags:check": "node scripts/flags/check.mjs",
    "assets:generate": "pnpm --filter @netverse/game-assets run generate",
    "assets:export": "pnpm --filter @netverse/game-assets run export",
    "assets:check": "pnpm --filter @netverse/game-assets run check",
    "assets:library": "pnpm --filter @netverse/game-assets run library",
    "assets:sketch": "pnpm --filter @netverse/game-assets run sketch",
    "bootstrap": "node scripts/bootstrap.mjs",
    "infra:up": "node scripts/infra/compose.mjs up",
    "infra:down": "node scripts/infra/compose.mjs down",
    "infra:smoke": "node scripts/infra/compose.mjs smoke",
    "release:state": "node scripts/release/state.mjs",
    "docs:generate": "node scripts/docs/generate.mjs",
    "docs:check": "node scripts/docs/generate.mjs --check"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.1",
    "yaml": "^2.9.1"
  }
}
