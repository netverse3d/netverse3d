{
  "name": "netverse3d",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=22.14 <23",
    "pnpm": ">=11"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "lint": "eslint .",
    "format": "node scripts/format.mjs --write",
    "format:check": "node scripts/format.mjs --check",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "verify": "pnpm lint && pnpm format:check && pnpm test:scripts && pnpm trace:check && pnpm catalog:check && turbo run lint test build",
    "trace:check": "node scripts/trace/check-registry.mjs",
    "trace:link": "node scripts/drift/link.mjs",
    "catalog:check": "node scripts/catalog/check.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "yaml": "^2.9.1"
  }
}
