NODE_ENV=development
SERVICE_NAME=payment
SERVICE_VERSION=0.1.0
PORT=3000
LOG_LEVEL=info
CORS_ORIGINS=
TRUST_PROXY_HOPS=1
BODY_LIMIT=1mb
REQUEST_TIMEOUT_MS=30000
SWAGGER_ENABLED=true
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120
AUTH_JWKS_URL=http://identity:3000/.well-known/jwks.json
AUTH_ISSUER=http://identity:3000
AUTH_AUDIENCE=payment
AUTH_ROLES_CLAIM=roles
AUTH_TENANT_CLAIM=tenant_id
OUTBOX_WORKER_ENABLED=true
OUTBOX_WORKER_INTERVAL_MS=5000
OUTBOX_MAX_ATTEMPTS=12
RECONCILIATION_ENABLED=true
RECONCILIATION_INTERVAL_MS=60000
RECONCILE_MIN_AGE_SECONDS=300
RECONCILE_SPACING_SECONDS=300
RECONCILE_MAX_AGE_HOURS=72
RECONCILIATION_SERVER_IP=127.0.0.1
OUTBOUND_HTTP_TIMEOUT_MS=10000
PAYMENT_PROVIDERS_ENABLED=vietqr
PROVIDER_HTTP_TIMEOUT_MS=10000
PAYMENT_EXPIRY_GRACE_MINUTES=10
PAYMENT_REFRESH_MIN_INTERVAL_SECONDS=10
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
PAYOS_API_BASE_URL=https://api-merchant.payos.vn
PAYOS_ORDER_CODE_OFFSET=0
LOG_PRETTY=false
