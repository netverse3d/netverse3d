NODE_ENV=development
SERVICE_NAME=identity
SERVICE_VERSION=0.1.0
PORT=3000
LOG_LEVEL=info
CORS_ORIGINS=
TRUST_PROXY_HOPS=1
BODY_LIMIT=1mb
REQUEST_TIMEOUT_MS=30000
SWAGGER_ENABLED=true
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=20
AUTH_JWKS_URL=http://127.0.0.1:3000/.well-known/jwks.json
AUTH_ISSUER=http://identity:3000
AUTH_AUDIENCE=identity
AUTH_ROLES_CLAIM=roles
AUTH_TENANT_CLAIM=tenant_id
TOKEN_AUDIENCES=media,notification,payment
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_REUSE_GRACE_SECONDS=10
KEY_RETIRE_GRACE_HOURS=24
PASSWORD_BCRYPT_COST=12
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_DELIVERY=notification
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
KAFKA_BROKERS=netverse-kafka-kafka-bootstrap.netverse-data.svc:9092
JOBS_ENABLED=true
CLEANUP_INTERVAL_SECONDS=3600
OUTBOX_RELAY_INTERVAL_MS=5000
OUTBOX_MAX_ATTEMPTS=12
LOG_PRETTY=false
OTP_NOTIFICATION_ADDRESS=notification:50051
