NODE_ENV=development
SERVICE_NAME=notification
SERVICE_VERSION=0.1.0
PORT=3000
LOG_LEVEL=info
CORS_ORIGINS=
TRUST_PROXY_HOPS=1
BODY_LIMIT=1mb
REQUEST_TIMEOUT_MS=30000
SWAGGER_ENABLED=true
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120
AUTH_JWKS_URL=http://identity:3000/.well-known/jwks.json
AUTH_ISSUER=http://identity:3000
AUTH_AUDIENCE=notification
AUTH_ROLES_CLAIM=roles
AUTH_TENANT_CLAIM=tenant_id
DEFAULT_LOCALE=en
EMAIL_PROVIDER=smtp
PUSH_PROVIDER=log
PROVIDER_TIMEOUT_MS=10000
EVENT_TRANSPORT=kafka
KAFKA_BROKERS=netverse-kafka-kafka-bootstrap.netverse-data.svc:9092
JOBS_ENABLED=true
DELIVERY_POLL_INTERVAL_MS=2000
DELIVERY_BATCH_SIZE=50
DELIVERY_CONCURRENCY=10
DELIVERY_MAX_ATTEMPTS=6
DELIVERY_RETRY_BASE_MS=30000
DELIVERY_RETRY_MAX_MS=3600000
DELIVERY_LEASE_MS=300000
OUTBOX_RELAY_INTERVAL_MS=5000
OUTBOX_MAX_ATTEMPTS=12
LOG_PRETTY=false
GRPC_PORT=50051
EMAIL_FROM_ADDRESS=no-reply@netverse.test
EMAIL_FROM_NAME=Netverse
SMTP_HOST=mailbox.netverse-data.svc
SMTP_PORT=1025
EVENT_CONSUMER_GROUP=notification
